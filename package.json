{
  "name": "ghostwire-analytics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "description": "Self-hosted, privacy-first web analytics for the Ghostwire suite.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm-run-all build:db build:tracker build:recorder build:geo build:app",
    "build:app": "next build",
    "build:db": "prisma generate",
    "start": "next start",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-admin": "tsx scripts/create-admin.ts",
    "build:tracker": "rollup -c rollup.tracker.config.mjs",
    "build:recorder": "rollup -c rollup.recorder.config.mjs",
    "build:geo": "node scripts/build-geo.mjs",
    "db:seed": "tsx scripts/seed-data.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.14",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colord": "^2.10.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debug": "^4.4.3",
    "detect-browser": "^5.3.0",
    "dotenv": "^18.0.9",
    "input-otp": "^1.5.0",
    "ipaddr.js": "^2.5.0",
    "is-localhost-ip": "^3.0.1",
    "isbot": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.64.0",
    "maxmind": "^5.0.7",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.0",
    "npm-run-all": "^4.1.5",
    "papaparse": "^5.7.0",
    "prisma": "7.10.1",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-simple-maps": "^5.0.5",
    "recharts": "^3.10.1",
    "rrweb": "^2.2.0",
    "rrweb-player": "^2.2.0",
    "serialize-error": "^13.0.2",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "source-map-js": "^1.2.2",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/debug": "^4.1.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
