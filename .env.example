# Copy to .env.local for `npm run dev`, or .env for docker compose.

# PostgreSQL (dev: `docker compose up -d db` exposes it on localhost:5436)
DATABASE_URL=postgresql://ghostwire:ghostwire@localhost:5436/ghostwire_analytics

# Better Auth. Generate the secret with: npx auth secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: delete raw replay, heatmap and error data older than N days (unset or 0 = keep).
# DATA_RETENTION_DAYS sets all three; the others override it.
# DATA_RETENTION_DAYS=90
# REPLAY_RETENTION_DAYS=
# HEATMAP_RETENTION_DAYS=
# ERROR_RETENTION_DAYS=

# docker compose --profile backup: how many days of daily dumps to keep in ./backups
# BACKUP_KEEP_DAYS=14

# Alerts and reports by email (optional). Links in alerts use APP_URL (default BETTER_AUTH_URL).
# SMTP_URL=smtp://user:password@mail.example.com:587
# SMTP_FROM="Ghostwire Analytics <alerts@example.com>"
# APP_URL=https://analytics.example.com

# Single sign-on with an OpenID Connect provider (optional): Authentik, Keycloak, Entra ID...
# Register the callback URL <BETTER_AUTH_URL>/api/auth/callback/oidc with the provider.
# Existing users sign in when the provider's verified email matches theirs.
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/ghostwire/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# OIDC_AUTO_CREATE=false

# Running more than one app container: share rate-limit counters through Postgres.
# RATE_LIMIT_STORE=postgres

# The app's own logs (docker compose keeps them in the app-logs volume).
# LOG_LEVEL=info            # debug | info | warn | error
# LOG_RETENTION_DAYS=30
# LOG_DIR=./logs            # for npm run dev; unset = stdout only
# STATS_INTERVAL_MINUTES=5  # how often traffic counters are logged
