# Copy to .env.local for `npm run dev`, or .env for docker compose.

# PostgreSQL (dev: `docker compose up -d db` exposes it on localhost:5436)
DATABASE_URL=postgresql://ghostwire:ghostwire@localhost:5436/ghostwire_analytics

# Better Auth. Generate the secret with: npx auth secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
