{
  "name": "@ghostwire/node",
  "version": "0.1.0",
  "description": "Server-side error reporting, releases and source maps for Ghostwire Analytics (Node, Express, Next.js).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/garethcheyne/ghostwire-analytics.git",
    "directory": "packages/node"
  },
  "keywords": [
    "error-reporting",
    "express",
    "nextjs",
    "node",
    "ghostwire"
  ],
  "bin": {
    "ghostwire": "./dist/cli.js"
  }
}
